# {{ ansible_managed }}
# Se carga antes de levantar la red, como nftables.service
[Unit]
Description=Cortafuegos de la máquina (nftables)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cortafuegos.nft
ExecReload=/usr/sbin/nft -f /etc/cortafuegos.nft
ExecStop=/usr/sbin/nft delete table inet cortafuegos

[Install]
WantedBy=sysinit.target
