CREATE TABLE IF NOT EXISTS notas (
    id      SERIAL PRIMARY KEY,
    autor   VARCHAR(50)  NOT NULL,
    texto   VARCHAR(500) NOT NULL,
    creada  TIMESTAMPTZ  NOT NULL DEFAULT now()
);

